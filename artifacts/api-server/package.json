{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm run typecheck || true && pnpm run lint && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "lint": "eslint src/routes/",
    "typecheck": "tsc -p tsconfig.json --noEmit || true",
    "test:auth": "node ./test-build.mjs src/routes/auth.test.ts",
    "test:quota": "node ./test-build.mjs src/lib/quota.test.ts",
    "test:auth-middleware": "node ./test-build.mjs src/middlewares/auth.test.ts",
    "test:citation-cleanup": "node ./test-build.mjs src/lib/citation-cleanup.test.ts",
    "test:chat": "node ./test-build.mjs src/routes/chat.test.ts"
  },
  "dependencies": {
    "@types/express-session": "^1.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^11.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "adm-zip": "^0.6.0",
    "bufferutil": "^4.1.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "input": "^1.0.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^1.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.47.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "telegram": "^2.26.22",
    "utf-8-validate": "^6.0.6",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "bcryptjs": "^3.0.3",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
