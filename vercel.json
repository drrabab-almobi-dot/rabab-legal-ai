{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/rabab-legal/dist/public",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.rabablegal.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://rabablegal.com/$1"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(self)",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.moyasar.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self' https://api.moyasar.com https://cdn.jsdelivr.net; frame-src https://cdn.moyasar.com"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://rabab-legal-ai-api.vercel.app/api/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:appointment|packages|disclaimer|design-preview|login|register|forgot-password|reset-password|consultation(?:/[^/]+)?|contracts|legal-search|legal-assistant|knowledge-search|services/[^/]+|payment(?:/.*)?|invoices/[^/]+|dashboard|account|usage-log|organization|join-org|admin(?:/.*)?)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
